{
  "name": "clinic-os-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npm run dev -w @clinic-os/web",
    "build": "npm run build -w @clinic-os/web",
    "lint": "npm run lint -w @clinic-os/web",
    "typecheck": "npm run typecheck -w @clinic-os/web",
    "test": "npm run test -w @clinic-os/web",
    "export:zip": "bash scripts/export-zip.sh"
  }
}
